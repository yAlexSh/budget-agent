LLM_PROVIDER=ollama                 # ollama (по умолчанию) | router
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:120b-cloud     # демо; в контуре — локальная модель из лестницы
LLM_STRUCTURED_MODE=auto            # auto | strict | json_object | prompt
LLM_DISABLE_THINKING=1
ROUTER_API_URL=https://api.deepseek.com   # запасной путь вне контура
ROUTER_API_KEY=
ROUTER_MODEL=deepseek-v4-flash
EMBED_URL=http://127.0.0.1:11434
EMBED_MODEL=qwen3-embedding:0.6b
PG_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_HTTP_PROXY=
TELEGRAM_REPORT_CHAT_ID=            # id общего чата для --report-cron; без него отчёт идёт в stdout
PERSON_HUSBAND_TG_ID=
PERSON_WIFE_TG_ID=
TELEGRAM_ALLOWED_GROUP_CHAT_IDS=    # comma-separated chat_id; empty disables all group chats
MCP_CBR_CMD=uvx atomno-mcp-cbr-rates@0.1.10
MCP_INIT_TIMEOUT_SECONDS=60         # необязательно; первый запуск через uvx медленнее обычного вызова
MCP_CALL_TIMEOUT_SECONDS=15         # необязательно; таймаут обычного tools/call и tools/list
BROADCAST_STEPS=1                   # трансляция шагов агента в чат: 1 в демо, 0 в закрытом контуре
